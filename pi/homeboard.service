[Unit]
Description=Homeboard Family Calendar & Weather Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=__NODE_BIN__ __APP_DIR__/dist/server/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
